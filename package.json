{
  "name": "nana",
  "version": "3.0.0",
  "private": true,
  "description": "nana：个人小说、漫画与情境伴读",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test test/*.test.js",
    "web:dev": "npm run dev --prefix frontend",
    "web:build": "npm run build --prefix frontend",
    "web:typecheck": "npm run typecheck --prefix frontend",
    "verify:motion": "node scripts/verify-motion-static.js && node scripts/verify-motion-behavior.js && node scripts/verify-motion-extra.js && node scripts/verify-motion-overlays.js",
    "verify:motion:pages": "node scripts/verify-motion-pages.js",
    "verify:motion:geometry": "node scripts/verify-motion.js",
    "verify:mobile": "node scripts/verify-mobile-reader.js",
    "check:sources": "node scripts/check-sources.js",
    "audit:upstream": "node scripts/audit-upstream.js"
  },
  "dependencies": {
    "acorn": "8.15.0",
    "cheerio": "1.2.0",
    "iconv-lite": "0.7.0",
    "jsdom": "26.1.0",
    "undici": "7.30.0"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.5"
  }
}
