{
  "name": "nana",
  "version": "3.0.0",
  "private": true,
  "description": "nana：个人小说、漫画与情境伴读",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server/index.js",
    "test": "node --test test/*.test.js",
